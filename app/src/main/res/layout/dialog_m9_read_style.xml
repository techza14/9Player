<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/reader_menu_panel_bg">

    <LinearLayout
        android:id="@+id/style_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/style_weight"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/reader_menu_touch"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/reader_style_weight_normal"
                android:textColor="#2C241B"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/style_font"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/reader_menu_touch"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/reader_style_font"
                android:textColor="#2C241B"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/style_indent"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/reader_menu_touch"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/reader_style_indent"
                android:textColor="#2C241B"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/style_padding"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/reader_menu_touch"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/reader_style_padding"
                android:textColor="#2C241B"
                android:textSize="14sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/style_info"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/reader_menu_touch"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/reader_style_info"
                android:textColor="#2C241B"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/style_text_size_label"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/style_text_size"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="30" />

        <TextView
            android:id="@+id/style_letter_label"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:text="@string/reader_style_letter_spacing"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/style_letter_size"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="100" />

        <TextView
            android:id="@+id/style_line_label"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:text="@string/reader_style_line_spacing"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/style_line_size"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="28" />

        <TextView
            android:id="@+id/style_paragraph_label"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:text="@string/reader_style_paragraph_spacing"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/style_paragraph_size"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:max="32" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:text="@string/reader_style_page_anim"
            android:textColor="#7D6E5C"
            android:textSize="12sp" />

        <RadioGroup
            android:id="@+id/style_page_anim"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/style_anim_cover"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/reader_style_anim_cover" />

            <RadioButton
                android:id="@+id/style_anim_slide"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/reader_style_anim_slide" />

            <RadioButton
                android:id="@+id/style_anim_scroll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="@string/reader_style_anim_scroll" />

            <RadioButton
                android:id="@+id/style_anim_none"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/reader_style_anim_none" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:text="@string/reader_style_background"
            android:textColor="#7D6E5C"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/style_color_row"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/style_color_paper"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#F3E7CF"
                android:gravity="center"
                android:text="@string/reader_style_sample_text"
                android:textColor="#2C241B" />

            <TextView
                android:id="@+id/style_color_white"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:gravity="center"
                android:text="@string/reader_style_sample_text"
                android:textColor="#111111" />

            <TextView
                android:id="@+id/style_color_green"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#D9E6D2"
                android:gravity="center"
                android:text="@string/reader_style_sample_text"
                android:textColor="#25301F" />

            <TextView
                android:id="@+id/style_color_dark"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="#1F1F1F"
                android:gravity="center"
                android:text="@string/reader_style_sample_text"
                android:textColor="#D8D2C5" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
