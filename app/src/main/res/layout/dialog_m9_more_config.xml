<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/more_config_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/reader_menu_panel_bg"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/more_config_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/more_screen_orientation"
            style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/screen_direction" />
            <TextView
                android:id="@+id/more_screen_orientation_value"
                style="@style/ReaderMoreValue"
                android:text="@string/screen_unspecified" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_keep_light"
            style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/keep_light" />
            <TextView
                android:id="@+id/more_keep_light_value"
                style="@style/ReaderMoreValue"
                android:text="@string/reader_keep_light_default" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/pt_hide_status_bar" />
            <Switch
                android:id="@+id/more_hide_status_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/read_body_to_lh" />
            <Switch
                android:id="@+id/more_read_body_to_lh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/pt_hide_navigation_bar" />
            <Switch
                android:id="@+id/more_hide_navigation_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_progress_behavior"
            style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/progress_bar_behavior" />
            <TextView
                android:id="@+id/more_progress_behavior_value"
                style="@style/ReaderMoreValue"
                android:text="@string/reader_progress_behavior_page" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_selection_primary_action"
            style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/reader_selection_primary_action" />
            <TextView
                android:id="@+id/more_selection_primary_action_value"
                style="@style/ReaderMoreValue"
                android:text="@string/reader_selection_primary_default" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_zh_layout_row"
            style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/read_chinese_converter" />
            <TextView
                android:id="@+id/more_zh_layout_value"
                style="@style/ReaderMoreValue"
                android:background="@drawable/reader_menu_touch"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/reader_convert_state_enabled" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/text_full_justify" />
            <Switch
                android:id="@+id/more_text_full_justify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/text_bottom_justify" />
            <Switch
                android:id="@+id/more_text_bottom_justify"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/show_brightness_view" />
            <Switch
                android:id="@+id/more_show_brightness_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/no_anim_scroll_page" />
            <Switch
                android:id="@+id/more_no_anim_scroll_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/preview_image_by_click" />
            <Switch
                android:id="@+id/more_preview_image_by_click"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/settings_ebook_image_spoiler_title" />
            <Switch
                android:id="@+id/more_hide_unread_images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/more_click_regional_config"
            style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/click_regional_config" />
            <TextView
                android:id="@+id/more_click_regional_config_value"
                style="@style/ReaderMoreValue"
                android:text="@string/reader_click_region_summary_default" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/disable_return_key" />
            <Switch
                android:id="@+id/more_disable_return_key"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/show_read_title_addition" />
            <Switch
                android:id="@+id/more_show_read_title_addition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />
        </LinearLayout>

        <LinearLayout style="@style/ReaderMoreRow">
            <TextView
                style="@style/ReaderMoreLabel"
                android:text="@string/read_bar_style_follow_page" />
            <Switch
                android:id="@+id/more_read_bar_style_follow_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/more_reset_defaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="@string/reader_reset_defaults"
            android:textColor="#AA5B1E1E"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
