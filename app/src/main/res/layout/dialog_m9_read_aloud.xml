<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_audio_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/reader_menu_panel_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="6dp"
    android:paddingEnd="16dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/audio_prev_sentence_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/controller_previous"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/audio_play_prev"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/reader_menu_touch"
            android:padding="7dp"
            android:src="@drawable/reader_ic_skip_previous"
            android:tint="#2C241B" />

        <TextView
            android:id="@+id/audio_play_pause"
            android:layout_width="64dp"
            android:layout_height="42dp"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:text="@string/play"
            android:textColor="#2C241B"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/audio_play_next"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/reader_menu_touch"
            android:padding="7dp"
            android:src="@drawable/reader_ic_skip_next"
            android:tint="#2C241B" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/audio_next_sentence_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/controller_next"
            android:textColor="#2C241B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/audio_speed_label"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/read_aloud_speed"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <SeekBar
            android:id="@+id/audio_speed_seek"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/audio_speed_value"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#2C241B"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/audio_timer_label"
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/bookreader_sleep_timer"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/audio_timer_10"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:text="10分"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/audio_timer_30"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:text="30分"
            android:textColor="#2C241B"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/audio_timer_off"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/reader_menu_touch"
            android:gravity="center"
            android:text="@string/close"
            android:textColor="#2C241B"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
