<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_playback_bar_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/reader_menu_panel_bg"
    android:elevation="8dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="8dp">

    <ImageButton
        android:id="@+id/reader_playback_prev"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/reader_menu_touch"
        android:padding="9dp"
        android:src="@drawable/reader_ic_skip_previous"
        android:tint="#2C241B" />

    <ImageButton
        android:id="@+id/reader_playback_toggle"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/reader_menu_touch"
        android:padding="12dp"
        android:src="@drawable/reader_ic_play_24dp"
        android:tint="#2C241B" />

    <ImageButton
        android:id="@+id/reader_playback_next"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="18dp"
        android:background="@drawable/reader_menu_touch"
        android:padding="9dp"
        android:src="@drawable/reader_ic_skip_next"
        android:tint="#2C241B" />
</LinearLayout>
