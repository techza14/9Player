<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.ichi2.anki.permission.READ_WRITE_DATABASE" />
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="com.ichi2.anki" />
        <package android:name="com.ichi2.anki.debug" />
    </queries>

    <application
        android:name=".NinePlayerApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locale_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tset">
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <activity
            android:name=".LegadoReaderPrototypeActivity"
            android:exported="false"
            android:label="@string/settings_reader_prototype_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".BookReaderActivity"
            android:exported="false"
            android:label="Book Reader"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".AnkiSettingsActivity"
            android:exported="false"
            android:label="Anki"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".DictionarySettingsActivity"
            android:exported="false"
            android:label="@string/settings_dictionary_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".AudiobookSettingsActivity"
            android:exported="false"
            android:label="@string/settings_audiobook_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".OverlaySettingsActivity"
            android:exported="false"
            android:label="@string/settings_overlay_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".FloatingOverlayPreviewActivity"
            android:exported="false"
            android:label="@string/settings_overlay_preview_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <service
            android:name=".AudiobookFloatingOverlayService"
            android:enabled="true"
            android:exported="false" />
        <activity
            android:name=".ControllerSettingsActivity"
            android:exported="false"
            android:label="Controller"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".ControlModeSettingsActivity"
            android:exported="false"
            android:label="Control Mode"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".AudiobookUiSettingsActivity"
            android:exported="false"
            android:label="@string/settings_audiobook_ui_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".MdxMountSettingsActivity"
            android:exported="false"
            android:label="@string/settings_mdx_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".OtherSettingsActivity"
            android:exported="false"
            android:label="@string/settings_other_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".StatisticsDemoActivity"
            android:exported="false"
            android:label="@string/settings_statistics_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".UpdateSettingsActivity"
            android:exported="false"
            android:label="@string/settings_update_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".FontSettingsActivity"
            android:exported="false"
            android:label="@string/settings_font_title"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tset">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>

